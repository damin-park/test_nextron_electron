# Conda environment used by Electron to run the FastAPI backend.
NEXTRON_CONDA_ENV=nextron-electron-backend

# Optional. Set this when conda is not on PATH.
# NEXTRON_CONDA_EXE=C:\Users\Nextron\anaconda3\Scripts\conda.exe

# Optional. Overrides Conda and runs this Python executable directly.
# NEXTRON_PYTHON=C:\Users\Nextron\anaconda3\envs\nextron-electron-backend\python.exe

# Backend bind address.
NEXTRON_BACKEND_HOST=127.0.0.1
NEXTRON_BACKEND_PORT=8765
